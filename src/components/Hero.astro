<canvas id='webglCanvas'></canvas>

<script>
import {
  Scene,
  PerspectiveCamera,
  WebGLRenderer,
  Clock,
  Vector3,
  BufferGeometry,
  BufferAttribute,
  Color,
  MathUtils,
  AmbientLight,
  DirectionalLight,
  Points,
  ShaderMaterial,
  AdditiveBlending,
  ACESFilmicToneMapping,
  FogExp2
} from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
import anime from 'animejs';
import { createNoise3D } from 'simplex-noise';

let scene, camera, renderer, controls, clock;
let composer, bloomPass;
let particlesGeometry, particlesMaterial, particleSystem;
let currentPositions, sourcePositions, swarmPositions;
let particleSizes, particleOpacities, particleEffectStrengths;
let noise3D;
let morphTimeline = null;
let isInitialized = false;
let isMorphing = false;

const CONFIG = {
  particleCount: 8000,
  pyramidSize: 14,
  swarmDistanceFactor: 1.5,
  swirlFactor: 4.0,
  particleSizeRange: [0.08, 0.25],
  bloomStrength: 1.3,
  bloomRadius: 0.5,
  bloomThreshold: 0.05
};

const morphState = { progress: 0.0 };
const COLOR_SCHEME = { startHue: 30, endHue: 50, saturation: 1.0, lightness: 0.6 };

const tempVec = new Vector3();
const sourceVec = new Vector3();
const swarmVec = new Vector3();
const bezPos = new Vector3();
const swirlAxis = new Vector3();

function generatePyramid(count, size) {
  const points = new Float32Array(count * 3);
  const half = size / 2;
  const height = size;
  const apex = new Vector3(0, height / 2, 0);
  const base = [
    new Vector3(-half, -height / 2, -half),
    new Vector3(half, -height / 2, -half),
    new Vector3(half, -height / 2, half),
    new Vector3(-half, -height / 2, half)
  ];
  for (let i = 0; i < count; i++) {
    let p = new Vector3();
    if (Math.random() < 0.2) {
      const u = Math.random();
      const v = Math.random();
      p.x = base[0].x + u * (base[2].x - base[0].x);
      p.z = base[0].z + v * (base[2].z - base[0].z);
      p.y = -height / 2;
    } else {
      const face = Math.floor(Math.random() * 4);
      let v0, v1;
      if (face === 0) { v0 = base[0]; v1 = base[1]; }
      else if (face === 1) { v0 = base[1]; v1 = base[2]; }
      else if (face === 2) { v0 = base[2]; v1 = base[3]; }
      else { v0 = base[3]; v1 = base[0]; }
      let u = Math.random();
      let w = Math.random();
      if (u + w > 1) { u = 1 - u; w = 1 - w; }
      p.copy(v0).multiplyScalar(1 - u - w).add(v1.clone().multiplyScalar(u)).add(apex.clone().multiplyScalar(w));
    }
    points[i * 3] = p.x;
    points[i * 3 + 1] = p.y;
    points[i * 3 + 2] = p.z;
  }
  return points;
}

function init() {
  clock = new Clock();
  noise3D = createNoise3D(() => Math.random());
  scene = new Scene();
  scene.fog = new FogExp2(0x000308, 0.03);

  camera = new PerspectiveCamera(70, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.set(0, 12, 28);
  camera.lookAt(scene.position);

  renderer = new WebGLRenderer({ canvas: document.getElementById('webglCanvas'), antialias: true, alpha: true, powerPreference: 'high-performance' });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.toneMapping = ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.1;

  controls = new OrbitControls(camera, renderer.domElement);
  controls.enableDamping = true;
  controls.dampingFactor = 0.05;
  controls.minDistance = 5;
  controls.maxDistance = 80;
  controls.autoRotate = true;
  controls.autoRotateSpeed = 0.3;

  scene.add(new AmbientLight(0x404060));
  const dirLight1 = new DirectionalLight(0xffffff, 1.5);
  dirLight1.position.set(15, 20, 10);
  scene.add(dirLight1);
  const dirLight2 = new DirectionalLight(0xffaa33, 0.9);
  dirLight2.position.set(-15, -10, -15);
  scene.add(dirLight2);

  composer = new EffectComposer(renderer);
  composer.addPass(new RenderPass(scene, camera));
  bloomPass = new UnrealBloomPass(new Vector3(window.innerWidth, window.innerHeight), CONFIG.bloomStrength, CONFIG.bloomRadius, CONFIG.bloomThreshold);
  composer.addPass(bloomPass);

  setupParticleSystem();

  addEventListener('resize', onWindowResize);
  addEventListener('click', onCanvasClick);

  isInitialized = true;
  animate();
}

function setupParticleSystem() {
  const positions = generatePyramid(CONFIG.particleCount, CONFIG.pyramidSize);
  currentPositions = new Float32Array(positions);
  sourcePositions = new Float32Array(positions);
  swarmPositions = new Float32Array(CONFIG.particleCount * 3);

  particlesGeometry = new BufferGeometry();
  particlesGeometry.setAttribute('position', new BufferAttribute(currentPositions, 3));

  particleSizes = new Float32Array(CONFIG.particleCount);
  particleOpacities = new Float32Array(CONFIG.particleCount);
  particleEffectStrengths = new Float32Array(CONFIG.particleCount);
  for (let i = 0; i < CONFIG.particleCount; i++) {
    particleSizes[i] = MathUtils.randFloat(CONFIG.particleSizeRange[0], CONFIG.particleSizeRange[1]);
    particleOpacities[i] = 1.0;
    particleEffectStrengths[i] = 0.0;
  }
  particlesGeometry.setAttribute('size', new BufferAttribute(particleSizes, 1));
  particlesGeometry.setAttribute('opacity', new BufferAttribute(particleOpacities, 1));
  particlesGeometry.setAttribute('aEffectStrength', new BufferAttribute(particleEffectStrengths, 1));

  const colors = new Float32Array(CONFIG.particleCount * 3);
  for (let i = 0; i < CONFIG.particleCount; i++) {
    const hue = MathUtils.mapLinear(i, 0, CONFIG.particleCount, COLOR_SCHEME.startHue, COLOR_SCHEME.endHue);
    const color = new Color().setHSL(hue / 360, COLOR_SCHEME.saturation, COLOR_SCHEME.lightness);
    color.toArray(colors, i * 3);
  }
  particlesGeometry.setAttribute('color', new BufferAttribute(colors, 3));

  particlesMaterial = new ShaderMaterial({
    uniforms: {},
    vertexShader: `attribute float size; attribute float opacity; attribute float aEffectStrength; varying vec3 vColor; varying float vOpacity; varying float vEffectStrength; void main(){vColor=color;vOpacity=opacity;vEffectStrength=aEffectStrength;vec4 mvPosition=modelViewMatrix*vec4(position,1.0);float sizeScale=1.0-vEffectStrength*0.5;gl_PointSize=size*sizeScale*(400.0/-mvPosition.z);gl_Position=projectionMatrix*mvPosition;}`,
    fragmentShader: `varying vec3 vColor; varying float vOpacity; varying float vEffectStrength; void main(){gl_FragColor=vec4(vColor*(1.0+vEffectStrength*0.6),vOpacity);}`,
    blending: AdditiveBlending,
    depthTest: true,
    depthWrite: false,
    transparent: true,
    vertexColors: true
  });

  particleSystem = new Points(particlesGeometry, particlesMaterial);
  scene.add(particleSystem);
}

function animate() {
  requestAnimationFrame(animate);
  if (!isInitialized) return;
  controls.update();
  composer.render();
}

function onCanvasClick(event) {
  if (isMorphing) return;
  isMorphing = true;
  controls.autoRotate = false;

  const originalPositions = new Float32Array(currentPositions);

  for (let i = 0; i < CONFIG.particleCount; i++) {
    const i3 = i * 3;
    sourceVec.fromArray(currentPositions, i3);
    const offsetDir = tempVec.set(noise3D(i*0.05,10,10), noise3D(20,i*0.05,20), noise3D(30,30,i*0.05)).normalize();
    swarmVec.copy(sourceVec).addScaledVector(offsetDir, CONFIG.pyramidSize * CONFIG.swarmDistanceFactor);
    swarmPositions[i3] = swarmVec.x;
    swarmPositions[i3+1] = swarmVec.y;
    swarmPositions[i3+2] = swarmVec.z;
  }

  morphState.progress = 0;
  if (morphTimeline) morphTimeline.pause();
  morphTimeline = anime({
    targets: morphState,
    progress: 1,
    duration: 2000,
    easing: 'easeInOutSine',
    update: () => {
      const t = morphState.progress;
      const effectStrength = Math.sin(t * Math.PI);
      for (let i=0;i<CONFIG.particleCount;i++){
        const i3=i*3;
        sourceVec.fromArray(originalPositions,i3);
        swarmVec.fromArray(swarmPositions,i3);
        if(t<0.5){
          bezPos.copy(sourceVec).lerp(swarmVec,t*2);
        } else{
          bezPos.copy(swarmVec).lerp(sourceVec,(t-0.5)*2);
        }
        if(effectStrength>0.01){
          tempVec.subVectors(bezPos,sourceVec);
          swirlAxis.set(noise3D(i*0.02,t,0),noise3D(0,i*0.02,t+5),noise3D(t+10,0,i*0.02)).normalize();
          tempVec.applyAxisAngle(swirlAxis,effectStrength*CONFIG.swirlFactor);
          bezPos.copy(sourceVec).add(tempVec);
        }
        currentPositions[i3]=bezPos.x;
        currentPositions[i3+1]=bezPos.y;
        currentPositions[i3+2]=bezPos.z;
        particleEffectStrengths[i]=effectStrength;
      }
      particlesGeometry.attributes.position.needsUpdate=true;
      particlesGeometry.attributes.aEffectStrength.needsUpdate=true;
    },
    complete: () => {
      currentPositions.set(originalPositions);
      particleEffectStrengths.fill(0);
      particlesGeometry.attributes.aEffectStrength.needsUpdate=true;
      isMorphing=false;
      controls.autoRotate=true;
    }
  });
}

function onWindowResize() {
  camera.aspect = window.innerWidth/window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth,window.innerHeight);
  composer.setSize(window.innerWidth,window.innerHeight);
}

init();
</script>
